# ShadowPaste — environment configuration
# Copy to .env and fill in real values. NEVER commit a real .env.
# For cloud deploys, set these in the Render / Vercel / Railway dashboard instead
# of a committed file. See DEPLOYMENT.md for the exact per-host manifest.

# ============================================================================
# REQUIRED — the app will not run correctly in production without these
# ============================================================================

# ---- Database (managed PostgreSQL) ----
# The Prisma provider is "postgresql". DATABASE_URL is the ONLY DB config; the
# same schema deploys to any Postgres (Render PG / Supabase / Neon / Railway).
#   Render PG : copy the "Internal Database URL" from the DB dashboard
#   Supabase  : Project Settings -> Database -> Connection string (URI)
#   Neon      : Dashboard -> Connection string (pooled)
# Local dev: run `docker compose up -d db` then use the line below.
DATABASE_URL=postgresql://shadow:shadow@localhost:5432/shadowpaste

# ---- Authentication pepper ----
# Keys password hashes AND session-token HMAC. Auth REFUSES to start in
# production with a missing/placeholder value. Generate a unique one:
#   openssl rand -hex 32
AUTH_PEPPER=

# ---- Vault master key ----
# Derives the AES-GCM-256 vault key via PBKDF2-SHA256 (210k iterations).
# On a writable local FS it is auto-generated into .env on first boot. On cloud
# hosts (read-only / ephemeral FS) you MUST set it explicitly, or every vaulted
# secret is destroyed on restart. Render can auto-generate + persist it for you.
#   SHADOWPASTE_MASTER_KEY=$(openssl rand -base64 32)
#   SHADOWPASTE_VAULT_SALT=$(openssl rand -base64 16)
# LOSING THIS KEY MAKES EVERY VAULTED SECRET PERMANENTLY UNRECOVERABLE.
SHADOWPASTE_MASTER_KEY=
SHADOWPASTE_VAULT_SALT=

# ============================================================================
# DEPLOYMENT — public URL, networking, CORS
# ============================================================================

# ---- Public app URL ----
# The canonical https URL of this deployment. Used for Stripe redirects and the
# MCP config the app hands out. If unset, the app derives it from the request's
# X-Forwarded-Proto/Host (works behind Vercel/Render), falling back to localhost.
#   Vercel : https://your-app.vercel.app
#   Render : https://shadowpaste.onrender.com
NEXT_PUBLIC_APP_URL=

# ---- Server bind (standalone / Docker) ----
# The Next.js standalone server honors these. Render/Railway inject PORT.
PORT=3000
HOSTNAME=0.0.0.0

# ---- CORS (optional) ----
# Comma-separated origins allowed to call the API cross-origin FROM A BROWSER
# (e.g. the Chrome extension host, or a dashboard on a different domain). Leave
# blank for same-origin only. Non-browser MCP clients (Claude Desktop) are
# unaffected. Use "*" to allow any origin (no credentials).
ALLOWED_ORIGINS=

# ---- OAuth 2.1 / MCP authorization ----
# ShadowPaste runs a real OAuth 2.1 authorization server (authorization-code +
# mandatory PKCE S256, rotating refresh tokens, RFC 7009 revocation) backed by
# its own user accounts — no external identity provider is required.
#
# When true, /api/mcp REQUIRES a valid OAuth access token and answers 401 with a
# WWW-Authenticate challenge otherwise. Set this to true for ANY publicly
# reachable deployment. Default (false) keeps local development frictionless.
REQUIRE_OAUTH=false

# ---- Proxy / rate limiting ----
# X-Forwarded-For is attacker-controlled unless a trusted proxy overwrites it, so
# it is IGNORED by default. Set true ONLY behind a real reverse proxy
# (Vercel/Render/Railway/Caddy all qualify).
TRUST_PROXY=false

# ---- Durable rate limiting (STRONGLY RECOMMENDED for any serverless deploy) ----
# Without these, rate limits are held in process memory. On Vercel/Lambda/Cloud Run
# every cold start gets a fresh counter and concurrent instances each keep their
# own, so a "60/min" limit is really 60 x (number of live instances) and resets
# unpredictably. Measured on this app before Redis support existed: 90 parallel
# requests to /api/mcp all returned 200.
#
# Set both to make limits global and cold-start-proof. If Redis is unreachable at
# request time the limiter falls back to the in-memory bucket rather than failing
# the request. GET /api/health reports which mode is active.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================================================
# OPTIONAL
# ============================================================================

# ---- Filesystem confinement (server-path import) ----
# OS-path-delimiter separated dirs the workspace engine may read/write. Defaults
# to the user's home dir locally. On cloud, set to a writable path (e.g. /tmp,
# or a mounted disk like /data on a paid Render instance).
# SHADOWPASTE_PROJECT_ROOTS=/tmp

# ---- Workspace storage ----
# Where AI-safe workspace copies are written. Defaults to <cwd>/.workspaces when
# self-hosted, and to the instance temp dir on a serverless runtime (the bundle
# directory there is read-only). Workspaces are namespaced per organization
# beneath this root, which is what keeps one tenant out of another's files.
#
# On serverless the temp dir is PER-INSTANCE and EPHEMERAL: an upload succeeds,
# but the workspace may not exist on the instance that serves the next request.
# Point this at a mounted volume for durable workspaces.
# SHADOWPASTE_WORKSPACE_ROOT=/data/workspaces

# ---- CLI ----
# Default backend URL used by the `shadowpaste` CLI (init/status). Point at your
# deployed URL to manage a remote instance.
# SHADOWPASTE_SERVER_URL=https://shadowpaste.onrender.com

# ---- AI providers (for the ai.generate MCP tool) ----
# The provider abstraction (src/lib/ai/provider.ts) resolves a key from the FIRST
# provider that has one, in AI_PROVIDER_ORDER. With none set, ai.generate returns
# a structured PROVIDER_NOT_CONFIGURED error — it never fabricates a response.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=            # alternative name accepted for Gemini
# Comma-separated preference/fallback order. Default: openai,anthropic,gemini
# AI_PROVIDER_ORDER=anthropic,openai,gemini

# ---- Network egress allowlist (for network.fetch / network.webhook) ----
# These tools are allowlist-only. api.github.com and api.stripe.com are always
# permitted; add extra hosts here (comma-separated). Private/loopback/metadata
# addresses and non-http(s) protocols are blocked unconditionally.
# NETWORK_ALLOWED_HOSTS=hooks.example.com,api.internal.example.com

# ---- Integrations ----
# Default GitHub token for repo scans when the caller supplies none:
# GITHUB_TOKEN=
# Stripe billing (leave unset to run billing in mock mode):
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Stripe price IDs used by /api/billing/checkout for each paid plan:
# STRIPE_PRO_PRICE_ID=
# STRIPE_TEAM_PRICE_ID=
# STRIPE_ENT_PRICE_ID=
# Stripe refunds require a TEST key (sk_test_/rk_test_) unless this is "true".
# Leave unset in production unless you intend real-money refunds.
# STRIPE_ALLOW_LIVE=false

# ---- Misc ----
# Optional shared token guarding POST /api/seed (demo data). When set, the
# request must present it; leave unset to keep seeding open in local dev only.
# SEED_TOKEN=
# APP_URL / CORS_ORIGINS are accepted as aliases for NEXT_PUBLIC_APP_URL and
# ALLOWED_ORIGINS respectively.
# NODE_ENV is set by the runtime (development | production) — do not set manually.

# ---- Alerting (Phase 12) ----
# Alerts are RECORDED regardless; delivery needs at least one adapter. With none
# set, /api/health reports "NO delivery adapter configured" — alerts exist but
# nobody is paged, which is the state the engine exists to make visible.
ALERT_WEBHOOK_URL=
# Enables HMAC signing: x-shadowpaste-signature: v1=<hmac sha256 of "<ts>.<body>">
ALERT_WEBHOOK_SECRET=
ALERT_SLACK_WEBHOOK_URL=
ALERT_TEAMS_WEBHOOK_URL=
# info | warning (default) | critical
ALERT_MIN_SEVERITY=warning

# ---- Tracing ----
# Without an endpoint, spans stay in a bounded in-process buffer readable via
# /api/v1/traces. Set this to export OTLP/HTTP JSON to any OTel collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=shadowpaste
# debug | info | warn | error  (defaults to info in production)
LOG_LEVEL=
