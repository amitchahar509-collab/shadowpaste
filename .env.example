# ShadowPaste — environment configuration
# Copy to .env and fill in real values. NEVER commit a real .env.

# ---- Database ----
# SQLite (default, zero-config local dev):
DATABASE_URL=file:./db/custom.db
# PostgreSQL (production target — see docker-compose.yml):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/shadowpaste

# ---- Authentication (REQUIRED in production) ----
# Keys password hashes and session-token HMAC. Generate a unique value:
#   openssl rand -hex 32
# The server refuses to start auth operations in production without this.
AUTH_PEPPER=

# ---- Vault master key (REQUIRED in production) ----
# Derives the AES-GCM-256 vault key via PBKDF2-SHA256 (210k iterations).
# On first local boot ShadowPaste generates this and appends it to .env for you.
# In production you MUST set it explicitly:
#   SHADOWPASTE_MASTER_KEY=$(openssl rand -base64 32)
#   SHADOWPASTE_VAULT_SALT=$(openssl rand -base64 16)
# LOSING THIS KEY MAKES EVERY VAULTED SECRET PERMANENTLY UNRECOVERABLE.
# Back it up with your other production secrets. Never commit it.
SHADOWPASTE_MASTER_KEY=
SHADOWPASTE_VAULT_SALT=

# ---- Proxy / rate limiting (optional) ----
# Rate limits are keyed on the client identity. X-Forwarded-For is attacker-
# controlled unless a trusted proxy overwrites it, so it is IGNORED by default.
# Set this ONLY when ShadowPaste genuinely runs behind a reverse proxy:
# TRUST_PROXY=true

# ---- Filesystem confinement (optional) ----
# OS-path-delimiter separated list of directories the workspace engine may
# read from / write to. Defaults to the current user's home directory when
# unset, so local projects under ~ can be protected without configuration.
# Set this explicitly (recommended for hosted/multi-tenant deployments) to
# confine imports to specific project roots.
# SHADOWPASTE_PROJECT_ROOTS=/home/you/projects

# ---- Integrations (optional) ----
# Default GitHub token for repo scans when the caller supplies none:
# GITHUB_TOKEN=
# Stripe billing (leave unset to run billing in mock mode):
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
