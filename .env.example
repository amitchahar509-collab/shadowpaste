# ShadowPaste — environment configuration
# Copy to .env and fill in real values. NEVER commit a real .env.
# For cloud deploys, set these in the Render / Vercel / Railway dashboard instead
# of a committed file. See DEPLOYMENT.md for the exact per-host manifest.

# ============================================================================
# REQUIRED — the app will not run correctly in production without these
# ============================================================================

# ---- Database (managed PostgreSQL) ----
# The Prisma provider is "postgresql". DATABASE_URL is the ONLY DB config; the
# same schema deploys to any Postgres (Render PG / Supabase / Neon / Railway).
#   Render PG : copy the "Internal Database URL" from the DB dashboard
#   Supabase  : Project Settings -> Database -> Connection string (URI)
#   Neon      : Dashboard -> Connection string (pooled)
# Local dev: run `docker compose up -d db` then use the line below.
DATABASE_URL=postgresql://shadow:shadow@localhost:5432/shadowpaste

# ---- Authentication pepper ----
# Keys password hashes AND session-token HMAC. Auth REFUSES to start in
# production with a missing/placeholder value. Generate a unique one:
#   openssl rand -hex 32
AUTH_PEPPER=

# ---- Vault master key ----
# Derives the AES-GCM-256 vault key via PBKDF2-SHA256 (210k iterations).
# On a writable local FS it is auto-generated into .env on first boot. On cloud
# hosts (read-only / ephemeral FS) you MUST set it explicitly, or every vaulted
# secret is destroyed on restart. Render can auto-generate + persist it for you.
#   SHADOWPASTE_MASTER_KEY=$(openssl rand -base64 32)
#   SHADOWPASTE_VAULT_SALT=$(openssl rand -base64 16)
# LOSING THIS KEY MAKES EVERY VAULTED SECRET PERMANENTLY UNRECOVERABLE.
SHADOWPASTE_MASTER_KEY=
SHADOWPASTE_VAULT_SALT=

# ============================================================================
# DEPLOYMENT — public URL, networking, CORS
# ============================================================================

# ---- Public app URL ----
# The canonical https URL of this deployment. Used for Stripe redirects and the
# MCP config the app hands out. If unset, the app derives it from the request's
# X-Forwarded-Proto/Host (works behind Vercel/Render), falling back to localhost.
#   Vercel : https://your-app.vercel.app
#   Render : https://shadowpaste.onrender.com
NEXT_PUBLIC_APP_URL=

# ---- Server bind (standalone / Docker) ----
# The Next.js standalone server honors these. Render/Railway inject PORT.
PORT=3000
HOSTNAME=0.0.0.0

# ---- CORS (optional) ----
# Comma-separated origins allowed to call the API cross-origin FROM A BROWSER
# (e.g. the Chrome extension host, or a dashboard on a different domain). Leave
# blank for same-origin only. Non-browser MCP clients (Claude Desktop) are
# unaffected. Use "*" to allow any origin (no credentials).
ALLOWED_ORIGINS=

# ---- Proxy / rate limiting ----
# X-Forwarded-For is attacker-controlled unless a trusted proxy overwrites it, so
# it is IGNORED by default. Set true ONLY behind a real reverse proxy
# (Vercel/Render/Railway/Caddy all qualify).
TRUST_PROXY=false

# ============================================================================
# OPTIONAL
# ============================================================================

# ---- Filesystem confinement (server-path import) ----
# OS-path-delimiter separated dirs the workspace engine may read/write. Defaults
# to the user's home dir locally. On cloud, set to a writable path (e.g. /tmp,
# or a mounted disk like /data on a paid Render instance).
# SHADOWPASTE_PROJECT_ROOTS=/tmp

# ---- CLI ----
# Default backend URL used by the `shadowpaste` CLI (init/status). Point at your
# deployed URL to manage a remote instance.
# SHADOWPASTE_SERVER_URL=https://shadowpaste.onrender.com

# ---- Integrations ----
# Default GitHub token for repo scans when the caller supplies none:
# GITHUB_TOKEN=
# Stripe billing (leave unset to run billing in mock mode):
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
