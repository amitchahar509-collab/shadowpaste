// ShadowPaste V19 — AI Agent Security Operating System (Production Schema)
// Multi-tenant SaaS: User / Organization / Team / Membership + orgId isolation.
// SQLite (sandbox); Postgres is the production target (see docker-compose.yml).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// PHASE 6 — SaaS BACKEND: User / Organization / Team
// ============================================================
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String?
  image         String?
  memberships   Membership[]
  sessions      UserSession[]
  agents        Agent[]   // agents created by this user
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model UserSession {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token         String   @unique
  expiresAt     DateTime
  createdAt     DateTime @default(now())
}

model Organization {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  plan          String   @default("free") // free, pro, enterprise
  memberships   Membership[]
  agents        Agent[]
  projects      Project[]
  vaultEntries  VaultEntry[]
  toolExecutions ToolExecution[]
  auditLogs     AuditLog[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Team {
  id            String   @id @default(cuid())
  orgId         String
  name          String
  memberships   Membership[]
  createdAt     DateTime @default(now())
}

model Membership {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  teamId        String?
  team          Team?    @relation(fields: [teamId], references: [id])
  role          String   @default("VIEWER") // OWNER, ADMIN, DEVELOPER, VIEWER
  createdAt     DateTime @default(now())
}

// ============================================================
// PHASE 5 — AI AGENT IDENTITY (multi-tenant)
// ============================================================
model Agent {
  id            String   @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  name          String
  provider      String   // ChatGPT, Claude, Cursor, Gemini, Copilot, Custom
  description   String?
  trustScore    Int      @default(50)
  status        String   @default("active") // active, suspended, revoked, quarantined
  avatarColor   String   @default("#10b981")
  modelVersion  String?
  apiKeyHash    String?  // hash of agent's own API key (if it connects via key)
  sessions      Session[]
  permissions   Permission[]
  toolCalls     ToolCall[]
  totalCalls    Int      @default(0)
  deniedCalls   Int      @default(0)
  allowedCalls  Int      @default(0)
  lastActiveAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Session {
  id            String   @id @default(cuid())
  agentId       String
  agent         Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  status        String   @default("active")
  context       String?
  source        String?  // claude-code, cursor, chatgpt, mcp-stdio, mcp-sse, api
  ipAddr        String?
  toolCalls     ToolCall[]
  permissions   Permission[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================================
// PHASE 3 — PERMISSION CONTROL CENTER
// ============================================================
model Permission {
  id            String   @id @default(cuid())
  agentId       String
  agent         Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  sessionId     String?
  session       Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  toolName      String
  scope         String
  decision      String   @default("ask") // allow_always, allow_once, ask, deny
  riskLevel     String   @default("low")
  grantedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================================
// PHASE 1 & 8 — MCP TOOL REGISTRY + MARKETPLACE
// ============================================================
model McpTool {
  id            String   @id @default(cuid())
  name          String   @unique
  category      String
  description   String
  riskLevel     String   @default("low")
  riskScore     Int      @default(10)
  inputSchema   String
  enabled       Boolean  @default(true)
  packageName   String?
  toolCalls     ToolCall[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model McpPackage {
  id            String   @id @default(cuid())
  name          String   @unique
  displayName   String
  description   String
  category      String
  icon          String?
  installs      Int      @default(0)
  verified      Boolean  @default(false)
  riskLevel     String   @default("low")
  publisher     String   @default("ShadowPaste")
  version       String   @default("1.0.0")
  toolCount     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================================
// PHASE 4 — ENCRYPTED VAULT (AES-GCM-256)
// ============================================================
model VaultEntry {
  id              String   @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projectId       String?
  name            String
  provider        String   // GITHUB, STRIPE, AWS, OPENAI, ...
  scope           String   // github.repo, stripe.charges, ...
  fingerprint     String   // sha256(raw) for dedup
  masked          String   // masked evidence for display
  encryptedIv     String   // JSON array
  encryptedCipher String   // base64
  rotatedAt       DateTime?
  revokedAt       DateTime?
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
}

// ============================================================
// PHASE 1 & 4 & 10 — TOOL CALLS (real execution audit) + FLIGHT RECORDER
// ============================================================
model ToolCall {
  id            String   @id @default(cuid())
  agentId       String
  agent         Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  sessionId     String?
  session       Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  toolId        String?
  tool          McpTool? @relation(fields: [toolId], references: [id])
  toolName      String
  input         String   // JSON, REDACTED of any secrets
  output        String?  // JSON, REDACTED of any secrets
  riskScore     Int      @default(0)
  riskLevel     String   @default("low")
  decision      String   // allowed, denied, blocked, pending, sandboxed
  reason        String?
  duration      Int?
  capabilityToken String? // nonce of the capability token used (if any)
  executed      Boolean  @default(false) // did real execution happen?
  createdAt     DateTime @default(now())
}

model ToolExecution {
  id            String   @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  toolCallId    String?
  toolName      String
  adapter       String   // filesystem, github, database, stripe
  input         String   // JSON
  output        String?  // JSON
  status        String   // success, error, blocked
  errorMessage  String?
  durationMs    Int
  createdAt     DateTime @default(now())
}

model AuditLog {
  id            String   @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actorType     String   // user, agent, system
  actorId       String?
  action        String   // agent.create, vault.store, tool.invoke, scan.run
  target        String?
  metadata      String?  // JSON
  createdAt     DateTime @default(now())
}

// ============================================================
// PHASE 5 — PROJECTS + SANDBOX
// ============================================================
model Project {
  id               String   @id @default(cuid())
  orgId            String
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name             String
  repoUrl          String?
  description      String?
  trustScore       Int      @default(0)
  secretsProtected Int      @default(0)
  riskyFiles       Int      @default(0)
  agentPermissions Int      @default(0)
  securityIssues   Int      @default(0)
  status           String   @default("scanned")
  sandboxStatus    String   @default("none")
  fileCount        Int      @default(0)
  scans            Scan[]
  sandboxChanges   SandboxChange[]
  vaultEntries     VaultEntry[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Scan {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type          String
  status        String   @default("completed")
  findings      String
  score         Int      @default(0)
  createdAt     DateTime @default(now())
}

model SandboxChange {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentId       String?
  filePath      String
  changeType    String
  diff          String
  riskLevel     String   @default("low")
  riskReason    String?
  approved      Boolean  @default(false)
  createdAt     DateTime @default(now())
}

// ============================================================
// PHASE 11 — ATTACK TESTS
// ============================================================
model AttackTest {
  id            String   @id @default(cuid())
  type          String
  description   String
  payload       String
  result        String
  severity      String
  defense       String?
  createdAt     DateTime @default(now())
}

// ============================================================
// PHASE 10 — PUBLIC SCANNER (no login)
// ============================================================
model PublicScan {
  id            String   @id @default(cuid())
  repoUrl       String
  repoName      String
  score         Int
  secrets       Int
  permissions   Int
  configs       Int
  findings      String
  shareId       String   @unique
  createdAt     DateTime @default(now())
}
