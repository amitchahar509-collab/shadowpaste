{
  "name": "shadowpaste-cursor",
  "displayName": "ShadowPaste for Cursor",
  "description": "Cursor-tuned ShadowPaste bridge — re-exports the VS Code extension and adds a Cursor-specific MCP config command (uses the `cursor` key from /api/mcp-config).",
  "version": "0.1.0",
  "publisher": "shadowpaste",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Security", "Other"],
  "main": "./out/cursor/src/extension.js",
  "activationEvents": [
    "onCommand:shadowpaste.scanWorkspace",
    "onCommand:shadowpaste.protectSecrets",
    "onCommand:shadowpaste.connectMcp",
    "onCommand:shadowpaste.cursorMcp"
  ],
  "contributes": {
    "commands": [
      {
        "command": "shadowpaste.scanWorkspace",
        "title": "ShadowPaste: Scan Workspace for Secrets",
        "category": "ShadowPaste"
      },
      {
        "command": "shadowpaste.protectSecrets",
        "title": "ShadowPaste: Protect Secrets in Active Document",
        "category": "ShadowPaste"
      },
      {
        "command": "shadowpaste.connectMcp",
        "title": "ShadowPaste: Show MCP Config (Claude Desktop / Cursor)",
        "category": "ShadowPaste"
      },
      {
        "command": "shadowpaste.cursorMcp",
        "title": "ShadowPaste: Open Cursor MCP Config",
        "category": "ShadowPaste"
      }
    ],
    "configuration": {
      "title": "ShadowPaste",
      "properties": {
        "shadowpaste.serverUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "Base URL of the ShadowPaste backend. All API calls are made to relative paths under this URL."
        },
        "shadowpaste.apiKey": {
          "type": "string",
          "default": "",
          "description": "Optional eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzaGFkb3ciOiJzYWZlIiwidGVzdCI6dHJ1ZX0.shadownX7xY9RF0KAiHTmeMoYK sent as Authorization: Bearer <apiKey>."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.3.0"
  },
  "license": "MIT"
}
